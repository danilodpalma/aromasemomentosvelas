datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Insumo {
  id                Int          @id @default(autoincrement())
  name              String
  active            Boolean      @default(true)
  unit              String?
  purchaseCost      Float
  purchasedQuantity Float
  unitCost          Float
  description       String?
  productTypes      String?
  isBase            Boolean      @default(false)
  stock             Int          @default(0)
  createdAt         DateTime     @default(now())
  sales             Sale[]
  compraItems       CompraItem[]
}

model Modelo {
  id            Int      @id @default(autoincrement())
  nome          String
  ativo         Boolean  @default(true)
  valorVendido  Float    @default(0)
  tipoProduto   String?
  baseNome      String?
  base2Nome     String?
  ceraGr        Float
  cera2Gr       Float    @default(0)
  esenciaMl     Float
  essenciaNome  String?
  pavio         String?
  coranteNome   String?
  coranteGr     Float
  recipiente    String?
  pedra         String?
  pedraGr       Float    @default(0)
  extrato       String?
  extratoGr     Float
  lauril        String?
  laurilGr      Float
  oleo          String?
  oleoGr        Float    @default(0)
  argila        String?
  argilaGr      Float    @default(0)
  dioxido       String?
  dioxidoGr     Float    @default(0)
  manteiga      String?
  manteigaGr    Float    @default(0)
  embalagem     Float
  maoDeObra     Float
  margemLucro   Float
  createdAt     DateTime @default(now())
}

model Sale {
  id        Int      @id @default(autoincrement())
  insumoId  Int
  quantity  Int
  unitPrice Float
  total     Float
  createdAt DateTime @default(now())
  insumo    Insumo   @relation(fields: [insumoId], references: [id])
}

model Venda {
  id             Int      @id @default(autoincrement())
  dataVenda      DateTime
  cliente        String
  modeloVela     String
  quantidade     Int
  precoUnitario  Float
  total          Float
  formaPagamento String
  status         String
  observacao     String?
  createdAt      DateTime @default(now())
}

model Compra {
  id              Int          @id @default(autoincrement())
  data            DateTime
  tipoLancamento  String
  categoria       String?
  descricao       String?
  valor           Float
  status          String       @default("Pendente")
  createdAt       DateTime     @default(now())
  itens           CompraItem[]
}

model CompraItem {
  id               Int      @id @default(autoincrement())
  compraId         Int
  insumoId         Int
  quantidade       Float
  unidade          String?
  custoUnitario    Float
  custoTotal       Float
  createdAt        DateTime @default(now())
  compra           Compra   @relation(fields: [compraId], references: [id])
  insumo           Insumo   @relation(fields: [insumoId], references: [id])
}

model ProductType {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  category  String   @default("productType")
  createdAt DateTime @default(now())
}
