# Copie este arquivo para .env e preencha com seus valores
# NUNCA comite .env com dados reais no GitHub!

# ===== Para Desenvolvimento Local (SQLite) =====
# DATABASE_URL="file:./dev.db"

# ===== Para Produção (PostgreSQL no Supabase) =====
# Obtenha a URL em: Supabase > Settings > Database > Connection String
DATABASE_URL="postgresql://postgres:SEU_PASSWORD@db.SEU_PROJETO.supabase.co:5432/postgres"

# ===== Chave JWT - Use uma string aleatória forte =====
# No Vercel, altere para uma chave MUITO forte e segura
JWT_SECRET="sua-chave-super-secreta-aleatoria-aqui"
